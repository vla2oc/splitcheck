# Скопировать в .env.local (он в .gitignore) и заполнить. На Vercel — те же имена в Settings → Environment Variables.

# Синк сессий: Supabase Dashboard → Connect (или Settings → API Keys). На Vercel обязательны
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…), НЕ secret. Legacy anon key тоже подойдёт
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Чтение чека (/api/parse, только на сервере). Без ключа работает только /?demo
ANTHROPIC_API_KEY=
# Необязательно: модель (по умолчанию claude-opus-5-5); MOCK_PARSE=1 — всегда демо-чек без Claude
PARSE_MODEL=
MOCK_PARSE=
