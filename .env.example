# Скопировать в .env.local (он в .gitignore) и заполнить: Supabase Dashboard → Connect (или Settings → API Keys).
# Пусто / нет файла → синк только между вкладками одного браузера (localStorage + BroadcastChannel).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…), НЕ secret. Legacy anon key тоже подойдёт
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
